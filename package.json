{
  "name": "hypemeet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"bun --watch server/index.ts\" \"vite\"",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite",
    "dev:lan": "LAN=1 concurrently -k -n api,web -c magenta,cyan \"bun --watch server/index.ts\" \"vite\"",
    "livekit": "docker compose up -d livekit",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "typecheck": "tsc -b",
    "desktop": "bun run --cwd desktop start",
    "desktop:build": "bun scripts/build-desktop.ts",
    "desktop:publish": "bun scripts/publish-desktop.ts"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "satori": "^0.35.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
